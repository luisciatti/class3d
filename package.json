{
  "name": "mundo-aprendizado",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "prepare": "husky",
    "db:generate": "pnpm --filter @mundo/api db:generate",
    "db:migrate": "pnpm --filter @mundo/api db:migrate",
    "db:seed": "pnpm --filter @mundo/api db:seed",
    "content:validate": "pnpm --filter @mundo/shared build && pnpm --filter @mundo/api exec tsx scripts/content/validate.ts",
    "content:sync": "pnpm --filter @mundo/shared build && pnpm --filter @mundo/api exec tsx scripts/content/sync.ts",
    "deps:up": "docker compose -f infra/compose/docker-compose.deps.yml up -d",
    "deps:down": "docker compose -f infra/compose/docker-compose.deps.yml down",
    "docker:up": "docker compose -f infra/compose/docker-compose.yml up --build",
    "docker:down": "docker compose -f infra/compose/docker-compose.yml down"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "^5.4.1"
    }
  }
}
